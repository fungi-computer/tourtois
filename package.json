{
  "name": "@fungi.computer/tourtois",
  "version": "0.1.0",
  "scripts": {
    "clean": "node --input-type=module --eval \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true });\"",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.workbench.json && tsc -p backend/tsconfig.json && tsc -p test/workerd/tsconfig.json",
    "build": "pnpm run clean && tsc -p tsconfig.build.json && cp src/shell.css src/chrome.css src/spa.css src/settings-navigation.css dist/",
    "build:spa": "vite build",
    "dev": "vite",
    "workbench": "ladle serve --host 127.0.0.1 --port 61001",
    "build:workbench": "pnpm run workbench:build"
  },
  "dependencies": {
    "@fungi.computer/agar": "0.2.0",
    "@fungi.computer/cairn": "0.0.1",
    "@fungi.computer/caps": "0.1.0",
    "@fungi.computer/gills": "0.1.0",
    "@fungi.computer/maosaico": "0.0.1",
    "@fungi.computer/oyster": "0.2.0",
    "@fungi.computer/parakeet": "0.1.0",
    "@fungi.computer/puffball": "0.1.0",
    "@fungi.computer/shiitake": "0.2.0",
    "@fungi.computer/sigils": "0.1.0",
    "@fungi.computer/sprite": "0.1.0",
    "@fungi.computer/sprite-zdog": "0.1.0",
    "@fungi.computer/whistle": "0.0.2",
    "@tanstack/history": "1.162.1",
    "@tanstack/react-form": "1.33.2",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "1.170.28",
    "@tanstack/router-core": "1.171.23",
    "animejs": "4.5.0",
    "effect": "4.0.2",
    "lucide-react": "0.460.0",
    "react-dom": "18.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260828.1",
    "@fungi.computer/forage": "0.1.0",
    "@fungi.computer/mycelium": "0.1.0",
    "@ladle/react": "5.1.1",
    "@types/react": "18.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "playwright": "1.62.1",
    "react": "18.3.1",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.135.0",
    "eslint": "10.9.1",
    "oxlint": "1.78.0",
    "tsx": "4.23.12",
    "jsdom": "29.0.1",
    "@types/node": "24.13.3",
    "@types/react-dom": "18.3.0"
  },
  "peerDependencies": {
    "react": "^18.3.1 || ^19.2.0"
  },
  "fungi": {
    "build": {
      "react": true,
      "shellEntry": "src/shell-module.ts",
      "packageStylesheets": [
        "@fungi.computer/caps",
        "@fungi.computer/parakeet"
      ]
    },
    "app": {
      "displayName": "Tourtois",
      "icon": "tourtois",
      "capabilities": [
        "team.workbenchHost",
        "app.storage"
      ],
      "handlers": [],
      "roles": [
        "dashboard"
      ],
      "commands": [],
      "storage": [
        {
          "key": "desktop",
          "scopes": [
            "team",
            "member"
          ],
          "maxBytes": 16384
        }
      ],
      "backend": {
        "bindings": [
          {
            "name": "APP_STORAGE",
            "operations": [
              "read",
              "write",
              "reset"
            ]
          },
          {
            "name": "APPS",
            "operations": [
              "catalog"
            ]
          }
        ]
      }
    },
    "backendDefinition": "backend/methods.ts"
  },
  "author": "Levi <levi@technomancy.dev>",
  "description": "Tourtois: the trusted desktop shell for Oyster and Fungi, with host-supplied Settings sections",
  "type": "module",
  "exports": {
    "./shell": {
      "types": "./dist/shell.d.ts",
      "import": "./dist/shell.js"
    },
    "./shell-module": {
      "types": "./dist/shell-module.d.ts",
      "import": "./dist/shell-module.js"
    },
    "./app-directory": {
      "types": "./dist/app-directory.d.ts",
      "import": "./dist/app-directory.js"
    },
    "./app-open-url": {
      "types": "./dist/app-open-url.d.ts",
      "import": "./dist/app-open-url.js"
    },
    "./app-surface": {
      "types": "./dist/app-surface.d.ts",
      "import": "./dist/app-surface.js"
    },
    "./styles.css": "./dist/shell.css",
    "./workbench": {
      "types": "./dist/workbench.d.ts",
      "import": "./dist/workbench.js"
    },
    "./platform-controls": {
      "types": "./dist/platform-controls.d.ts",
      "import": "./dist/platform-controls.js"
    },
    "./settings-routes": {
      "types": "./dist/settings-routes.d.ts",
      "import": "./dist/settings-routes.js"
    },
    "./team-directory": {
      "types": "./dist/team-directory.d.ts",
      "import": "./dist/team-directory.js"
    },
    "./app-authority": {
      "types": "./dist/app-authority.d.ts",
      "import": "./dist/app-authority.js"
    },
    "./app-call-permissions": {
      "types": "./dist/AppCallPermissions.d.ts",
      "import": "./dist/AppCallPermissions.js"
    },
    "./settings-leave-guard": {
      "types": "./dist/settings-leave-guard.d.ts",
      "import": "./dist/settings-leave-guard.js"
    },
    "./app-icon": {
      "types": "./dist/app-icon.d.ts",
      "import": "./dist/app-icon.js"
    },
    "./app-access-consent": {
      "types": "./dist/AppAccessConsent.d.ts",
      "import": "./dist/AppAccessConsent.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "botanical": {
    "role": "app",
    "operations": {
      "lint": "required",
      "typecheck": "required",
      "build": "required",
      "test": "required",
      "docs": {
        "status": "not-applicable",
        "reason": "App shell documented in README; shared docs tooling not yet wired for this App"
      },
      "pack": {
        "status": "not-applicable",
        "reason": "Shared pack tooling not yet wired for this App"
      },
      "smoke": {
        "status": "not-applicable",
        "reason": "The Bonsai standalone test:app-set and Hub browser proofs exercise the shell"
      },
      "stranger": {
        "status": "not-applicable",
        "reason": "Shared stranger consumer proof not yet wired for this App"
      }
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fungi-computer/tourtois.git"
  },
  "packageManager": "pnpm@11.24.0"
}
